{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.1.0",
  "identifier": "com.aether.vpn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aether",
        "width": 560,
        "height": 680,
        "resizable": true,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Network",
    "copyright": "Copyright © 2026 Ali Sawari",
    "shortDescription": "WireGuard VPN manager for Linux",
    "longDescription": "Aether is a lightweight Linux desktop app for managing WireGuard connections. Pick a workspace, import provider configs, generate WiFi/Ethernet route-aware configs, and connect from a native UI or the system tray.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/wgctl.sh": "scripts/wgctl.sh",
      "../LICENSE": "LICENSE"
    },
    "linux": {
      "deb": {
        "depends": [
          "wireguard-tools",
          "policykit-1"
        ]
      }
    }
  },
  "plugins": {}
}
